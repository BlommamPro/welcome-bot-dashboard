{
  "files.associations": {
    "*.ejs": "html"
  },
  "emmet.includeLanguages": {
    "ejs": "html"
  },
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "javascript.validate.enable": false,
  "typescript.validate.enable": true,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true
  }
}